# =============================================================================
# SalesMgt - Laravel production environment (cPanel / single domain)
# -----------------------------------------------------------------------------
# Copy this file to `.env` on the server, then fill in every value marked <...>.
# Generate a fresh APP_KEY from the server with:
#     php artisan key:generate
# =============================================================================

APP_NAME=SalesMgt
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.example.com
FRONTEND_URL=https://app.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Rotating logs keep the shared-hosting disk footprint small.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
# LOG_DAILY_DAYS=14

# -----------------------------------------------------------------------------
# Database - use the credentials created in cPanel > MySQL Databases.
# NOTE: on many cPanel hosts the database name and user are prefixed with the
# cPanel account name, e.g. `myaccount_salesmgt`.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=myaccount_salesmgt
DB_USERNAME=myaccount_salesmgt
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sessions - stored in the database for stability across PHP processes.
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave SESSION_DOMAIN empty for a host-only cookie, or set it to `.example.com`
# if the API and SPA share a parent domain.
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Shared hosting cannot run long-lived workers; run jobs inline.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=salesmgt

# -----------------------------------------------------------------------------
# Mail - e.g. Hostinger / cPanel mailbox over implicit TLS (port 465).
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@app.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Sanctum - first-party SPA host(s) allowed to use the stateful cookie flow.
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=app.example.com
SANCTUM_TOKEN_PREFIX=

# CORS - comma separated list of origins allowed to call the API.
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_SUPPORTS_CREDENTIALS=false

# If you terminate TLS at a proxy/CDN (Cloudflare, etc.) set the trusted proxy
# so Laravel detects HTTPS correctly, e.g. `*` behind Cloudflare.
# TRUSTED_PROXIES=*
