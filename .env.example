# API base URL. In production this should be the absolute URL of the Laravel API.
# When omitted, requests go to the same origin under /api/v1 (dev proxy targets Laravel).
VITE_API_BASE_URL=/api/v1

# Dev-only: target for the Vite dev-server proxy of /api (defaults to http://127.0.0.1:8000).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Optional override for the branded product name.
VITE_APP_NAME=SalesMgt

# Set to "false" to disable service-worker registration in dev/preview.
VITE_ENABLE_PWA=true