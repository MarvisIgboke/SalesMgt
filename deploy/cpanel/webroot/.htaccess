# =============================================================================
# SalesMgt - Apache configuration for the cPanel document root (public_html)
# -----------------------------------------------------------------------------
# Serves the compiled SPA and routes /api/* (and /up) to the Laravel front
# controller (index.php), which lives in this same directory and boots the
# Laravel application from ../salesmgt (outside the web root).
# =============================================================================

# --- Default document -------------------------------------------------------
# index.html first so that "/" serves the SPA, not the Laravel front controller.
DirectoryIndex index.html index.php

<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

# --- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# --- Security headers -------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS - enable only once HTTPS is fully working on the domain.
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Long-lived caching for hashed build assets; never cache the HTML shell.
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|json|webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # The service worker must never be cached, or updates will not roll out.
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- Force HTTPS (set to your real host if you prefer an absolute redirect)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # --- Pass the Authorization header through to PHP (needed for Bearer tokens)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # --- Pass the XSRF token header through to PHP
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # --- API + Laravel health check -> Laravel front controller
    RewriteRule ^api(/.*)?$ index.php [L]
    RewriteRule ^up$ index.php [L]

    # --- Real files and directories (SPA assets, /storage symlink, offline.html)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Drop trailing slashes on non-directories
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # --- Everything else -> SPA (client-side routing)
    RewriteRule ^ index.html [L]
</IfModule>

# --- Block access to sensitive files that might be uploaded by mistake ------
<FilesMatch "^\.(env|env\..*|git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
